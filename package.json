{
  "name": "yakolak-godot-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:setup-ui": "node --input-type=module --eval \"process.env.YAKOLAK_JSDOM_MODULE = import.meta.resolve('jsdom'); await import('./tests/visual_setup.mjs')\"",
    "test:release": "npm test && npm run test:setup-ui"
  },
  "dependencies": {
    "@tursodatabase/serverless": "^1.3.1"
  },
  "devDependencies": {
    "jsdom": "^30.1.2"
  }
}
