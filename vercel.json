{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "test -s web/index.html && echo 'Using flash-ready YAKOLAK web build'",
  "ignoreCommand": "git log -1 --pretty=%B | grep -Fq '[flash-ready]' && exit 1 || exit 0",
  "outputDirectory": "web",
  "framework": null,
  "github": {
    "autoJobCancelation": true
  },
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
