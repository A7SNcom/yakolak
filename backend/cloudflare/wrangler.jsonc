{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yakolak-room-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["17 * * * *"]
  }
}
